{
  "info": {
    "name": "API Livraria - Flask no Azure",
    "description": "Testes da API RESTful de livros publicada no Azure App Service. Rode em ordem (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://hello-flask-heloisa.azurewebsites.net"
    },
    {
      "key": "livroId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Listar livros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/livros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Retorna uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Filtrar por autor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/livros?autor=clarice",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros"
          ],
          "query": [
            {
              "key": "autor",
              "value": "clarice"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Todos são da Clarice\", () => pm.response.json().forEach(l => pm.expect(l.autor).to.include(\"Clarice\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Criar livro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/livros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Vidas Secas\",\n  \"autor\": \"Graciliano Ramos\",\n  \"preco\": 45.0,\n  \"estoque\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const livro = pm.response.json();",
              "pm.test(\"Livro criado com id\", () => pm.expect(livro.id).to.be.a(\"number\"));",
              "pm.collectionVariables.set(\"livroId\", livro.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Buscar livro criado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/livros/{{livroId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros",
            "{{livroId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"É o livro criado\", () => pm.expect(pm.response.json().titulo).to.eql(\"Vidas Secas\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Atualizar preço",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/livros/{{livroId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros",
            "{{livroId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preco\": 39.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Preço atualizado\", () => pm.expect(pm.response.json().preco).to.eql(39.9));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Criar livro inválido (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/livros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Sem autor\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Mensagem de erro\", () => pm.expect(pm.response.json()).to.have.property(\"erro\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Remover livro",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/livros/{{livroId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros",
            "{{livroId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Buscar livro removido (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/livros/{{livroId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livros",
            "{{livroId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}